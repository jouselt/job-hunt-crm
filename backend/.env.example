# Copy to .env and fill in real values.

# PostgreSQL connection string
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/job_hunt_crm

# Optional discrete DB vars (used when DATABASE_URL is absent)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=job_hunt_crm

# Auth
JWT_SECRET=replace-with-random-secret

# Offer triage (TypeSafe Jev API). Optional fallback: each user can save their
# own key in Settings, and that one wins. Without either, offers go to REVIEW.
JEV_API_KEY=

# SendGrid
SENDGRID_API_KEY=SG.replace-me
SENDGRID_FROM_EMAIL=no-reply@example.com
