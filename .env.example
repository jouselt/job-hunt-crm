# Compose-root env (copy to .env, fill in). Gitignored.
# These are ALSO needed inside backend/.env (see backend/.env.example).

# --- PostgreSQL ---
DB_USER=postgres
DB_PASS=postgres
DB_NAME=job_hunt_crm

# --- Backend ---
# Use the compose service host `postgres` here, NOT localhost.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/job_hunt_crm
JWT_SECRET=replace-with-a-long-random-string

# Optional SendGrid (reminder emails). Leave blank to log instead of send.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@example.com
SENDGRID_TO_EMAIL=

# CORS origin of the Caddy site, e.g. https://joe.example.com
# Leave blank in dev (permissive).
CORS_ORIGIN=
