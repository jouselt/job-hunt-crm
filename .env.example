# Compose-root env (copy to .env, fill in). Gitignored.
# Single source of truth — the backend container reads this file directly
# (docker-compose.yml `env_file: ./.env`).

# --- PostgreSQL ---
DB_USER=postgres
DB_PASS=postgres
DB_NAME=job_hunt_crm

# --- Backend ---
# Use the compose service host `postgres` here, NOT localhost.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/job_hunt_crm
# Generate a long random secret, e.g.:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Optional SendGrid (reminder emails). Leave blank to log instead of send.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@example.com
SENDGRID_TO_EMAIL=

# CORS origin of the public site, e.g. https://crm.example.com
# Leave blank for same-origin proxy (Caddy) or local dev (permissive).
CORS_ORIGIN=
